# =============================================================================
# HRM バックエンド 環境変数テンプレート
# このファイルをコピーして .env を作成してください：
#   cp .env.example .env
#
# CDK デプロイ後に出力される値（Outputs）を以下に設定してください。
# =============================================================================

# --- Django 基本設定 -----------------------------------------------------------
DJANGO_ENV=dev                          # dev / stg / prod
DJANGO_SECRET_KEY=your-secret-key-here  # python -c "import secrets; print(secrets.token_hex(50))" で生成
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=True                       # 本番環境では False に変更

# --- データベース（Amazon RDS PostgreSQL）--------------------------------------
# CDK Output: DbEndpoint の値を設定
DB_HOST=localhost                       # ローカル開発時は localhost
DB_PORT=5432
DB_NAME=hrm
DB_USER=hrm_admin
DB_PASSWORD=your-db-password-here       # ローカル開発用パスワード

# 本番環境では DB_SECRET_ARN を設定（DB_USER/DB_PASSWORDの代わりに使用）
# CDK Output: DbSecretArn の値を設定
DB_SECRET_ARN=

# --- AWS 共通設定 --------------------------------------------------------------
AWS_REGION=ap-northeast-1

# ローカル開発時のみ設定（本番はIAMロールで自動認証）
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Amazon S3 ----------------------------------------------------------------
# CDK Output: StorageBucketName の値を設定
S3_STORAGE_BUCKET=hrm-dev-storage-xxxxxxxxxxxx

# CDK Output: TemplateBucketName の値を設定
S3_TEMPLATE_BUCKET=hrm-dev-templates-xxxxxxxxxxxx

# --- AWS Cognito（ユーザー認証）------------------------------------------------
# CDK Output: UserPoolId の値を設定
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx

# CDK Output: UserPoolClientId の値を設定
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Amazon Bedrock（AI機能）--------------------------------------------------
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# --- メール送信（Amazon SES）--------------------------------------------------
# 本番環境で設定。開発環境はコンソール出力で代替
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django_ses.SESBackend
# AWS_SES_REGION_NAME=ap-northeast-1

# --- CORS 設定（フロントエンドのURLを設定）------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- OAuth 設定（Microsoft / Google カレンダー同期）-----------------------------
# Microsoft Azure: https://portal.azure.com で登録
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google Cloud: https://console.cloud.google.com で登録
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 運用強化機能（v1.1）すべて任意。右は既定値 -----------------------------------
# SCHEDULER_RUN_AT=06:00                 # 定期ジョブの実行時刻
# APPROVAL_REMIND_DAYS=3                 # 承認待ちを再通知する間隔（日）
# WORK_INTERVAL_MINUTES=660              # 勤務間インターバルの基準（分）
# COMPENSATORY_LEAVE_VALID_DAYS=90       # 休日出勤から代休を取得できる期限（日）
# PULSE_MIN_GROUP_SIZE=5                 # パルスサーベイで集計を表示する最小人数
# FRONTEND_URL=http://localhost:3000     # Slack / Teams 通知に載せる画面 URL の起点
# WEBHOOK_TIMEOUT_SECONDS=5

# --- セキュリティ（v1.3） -----------------------------------------------------
# 外部サービスの認証情報（API キー・連携トークン・Webhook URL）を暗号化する鍵。本番では必ず設定する
#   生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=
# CSRF を許可するフロントエンドの URL（既定は CORS_ALLOWED_ORIGINS と同じ）
# CSRF_TRUSTED_ORIGINS=http://localhost:3000
# 認証 Cookie のドメイン（フロントと API をサブドメインで分ける場合に親ドメインを指定。例: .example.com）
# AUTH_COOKIE_DOMAIN=
# 認証 Cookie の Secure 属性（既定は DEBUG=False のとき True）
# AUTH_COOKIE_SECURE=False
# ログインの回数制限・ロック
# LOGIN_RATE=10/min
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# 本番で HTTPS へのリダイレクトをロードバランサーに任せる場合は False
# SECURE_SSL_REDIRECT=True

# --- その他 -------------------------------------------------------------------
# タイムゾーン
TIME_ZONE=Asia/Tokyo
